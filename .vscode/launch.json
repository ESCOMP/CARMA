{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug CARMA test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/test_${input:testName}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build-debug",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build selected CARMA test",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ],
    "inputs": [
        {
            "id": "testName",
            "type": "promptString",
            "description": "CMake test name, without the test_ prefix",
            "default": "version"
        }
    ]
}